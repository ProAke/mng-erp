#!/usr/bin/env bash
# .githooks/pre-commit — บังคับตาม AGENTS.md ข้อ 1
# ใช้ผ่าน core.hooksPath=.githooks (ดู scripts/install-hook.sh)
set -uo pipefail

# --- re-exec ด้วย native arm64 ---
# Hermes desktop app รัน git ภายใต้ Rosetta (sysctl.proc_translated=1)
# → uname -m รายงาน x86_64 และ node ทุกตัวกลายเป็น x64
# → rollup/vitest หา native binary arm64 ไม่เจอ
# วิธีแก่: re-exec script นี้ใหม่ด้วย `arch -arm64`
# (ห้ามเช็ค uname -m — Rosetta จะรายงาน x86_64)
TRANSLATED="$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)"
if [ "$TRANSLATED" = "1" ]; then
  exec arch -arm64 /bin/bash "$0" "$@"
fi

# --- หา repo root ด้วย git (ห้ามใช้ dirname $0 — hooksPath relative จะ resolve ผิดที่) ---
ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/package.json" ]; then
  echo "pre-commit: หา repo root ไม่เจอ — ข้าม"
  exit 0
fi
cd "$ROOT"

# --- ยกเว้น commit ที่ไม่แตะโค้ด ---
MSG_FILE="$(git rev-parse --git-dir)/COMMIT_EDITMSG"
if [ -f "$MSG_FILE" ]; then
  SUBJ=$(head -1 "$MSG_FILE")
  case "$SUBJ" in
    "chore(deploy):"*|"Merge"*)
      echo "pre-commit: ข้ามการตรวจ ($SUBJ)"
      exit 0
      ;;
  esac
fi

# --- ตรวจเฉพาะ commit ที่แตะไฟล์โค้ด ---
TOUCHED=$(
  { git diff --cached --name-only; git diff --name-only; } 2>/dev/null \
    | grep -E '\.(js|ts|tsx|jsx|json|sh|css|html)$' || true
)
if [ -z "$TOUCHED" ]; then
  echo "pre-commit: ไม่มีไฟล์โค้ดเปลี่ยน — ข้าม"
  exit 0
fi

echo "pre-commit: กำลังตรวจสอบความถูกต้อง (lint / test / build)…"
if npm run verify > /tmp/pre-commit-verify.log 2>&1; then
  echo "pre-commit: ✅ ผ่าน"
  exit 0
fi

echo ""
echo "⛔ pre-commit หยุด commit — ยังไม่ผ่านการตรวจสอบ (AGENTS.md ข้อ 1)"
echo ""
grep -E "❌|error|Error|failed|×" /tmp/pre-commit-verify.log | head -20
echo ""
echo "แก้ให้ผ่านก่อน แล้ว commit ใหม่"
exit 1
