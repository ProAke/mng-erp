#!/usr/bin/env bash
exec > /tmp/hook-diag.log 2>&1
echo "=== pwd ==="; pwd
echo "=== uname -m ==="; uname -m
echo "=== sysctl.proc_translated ==="; sysctl -n sysctl.proc_translated
echo "=== which node ==="; which -a node
echo "=== node arch ==="; node -p "process.arch + ' ' + process.version"
echo "=== arch -arm64 node ==="; arch -arm64 node -p "process.arch + ' ' + process.version" 2>&1
echo "=== env NODE ==="; env | grep -iE "^(NODE|npm_config|PATH=)" | head -5
exit 0
