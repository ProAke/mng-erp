{
  "manifest_version": 3,
  "name": "Team Viewer — MNG ERP",
  "version": "1.0.0",
  "description": "ดูงานและสั่งงานทีมแบบ transparent ทุกคนรู้และยินยอม",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "desktopCapture",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
