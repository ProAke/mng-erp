# MNG ERP server config — copy to .env and fill real values
PORT=8080

# Auth DB (pacific_mng) — users / login
DB_AUTH_HOST=203.146.252.149
DB_AUTH_PORT=3306
DB_AUTH_USER=pacific_mng
DB_AUTH_PASS=CHANGE_ME
DB_AUTH_NAME=pacific_mng

# Work tracking DB (pacific_mngworks) — projects / tasks / calendar / finance
DB_WORK_HOST=203.146.252.149
DB_WORK_PORT=3306
DB_WORK_USER=pacific_mngworks
DB_WORK_PASS=CHANGE_ME
DB_WORK_NAME=pacific_mngworks

# Session lifetime (days)
SESSION_DAYS=7

# Optional Project Flow integrations (disabled until configured).
# HTTPS URLs only. Never put real keys in Git or expose them to the browser.
# OpenAI-compatible Chat Completions endpoint; model is selected by the operator.
FLOW_AI_URL=
FLOW_AI_KEY=
FLOW_AI_MODEL=
# HTTPS webhook controlled by the organization (for example, an n8n workflow).
# Secret must be at least 32 UTF-8 bytes; receiver must verify HMAC and event ID.
FLOW_WEBHOOK_URL=
FLOW_WEBHOOK_SECRET=
