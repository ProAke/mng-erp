{
  "name": "mng-erp",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "lint": "eslint . --ext .js",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "build": "cd web && npm ci && npm run build && cd .. && npm run sync:public",
    "build:web": "cd web && npm run build && cd .. && npm run sync:public",
    "sync:public": "node -e \"const fs=require('fs'),path=require('path');const src=path.resolve('web/out'),dst=path.resolve('server/public');fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true});console.log('[sync] web/out -> server/public complete');\"",
    "seed": "cd server && node seed.js",
    "seed:test": "cd server && node seed.js",
    "dev:server": "cd server && node index.js",
    "dev:web": "cd web && npm run dev",
    "verify": "npm run lint && npm test && npm run build:web",
    "deploy:plesk": "bash deploy-plesk.sh"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unicorn": "^53.0.0",
    "jsdom": "^26.1.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
